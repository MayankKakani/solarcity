# General URLs
# SOLARPLAN_CLIENT_URL=http://localhost:5173
# SOLARPLAN_API_URL=http://localhost:1337      # optional — defaults to SOLARPLAN_CLIENT_URL/api
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.abdwfbdujooqzcjtsjfx:gBtqAma#n67det9@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres"
# Database
# DATABASE_URL=                            # optional — use this for host-native or external DB access
# POSTGRES_DB=solarplan
# POSTGRES_USER=solarplan
# POSTGRES_PASSWORD=
# POSTGRES_HOST=postgres                   # Compose container default; use localhost for host-native API startup
# POSTGRES_PORT=5432
# Note: POSTGRES_DB and POSTGRES_USER alone do not enable derived connection mode.
# Derived DATABASE_URL is only used when POSTGRES_PASSWORD or an explicit host/port is set.

# Redis Pub/Sub for WebSockets (Optional) -> auto fallback to in memory
# Only one mode should be configured. Priority: Cluster > Sentinel > Standalone.

# Standalone
#REDIS_URL=

# Sentinel
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# Cluster
#REDIS_CLUSTER_NODES=

# Shared (Sentinel & Cluster)
#REDIS_PASSWORD=

# Authentication
# Generate with: openssl rand -hex 32
# If unset, a random secret is generated at startup (sessions won't survive restarts)
AUTH_SECRET=

# GitHub SSO (Sign in with GitHub — OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallback for SSO (used only if GITHUB_OAUTH_* are unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub integration (GitHub App — repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=

# WhatsApp Business Cloud API (Phone number sign-in / WhatsApp OTP)
# Requires a Meta app + WhatsApp Business Account with an approved
# authentication template (see WHATSAPP_OTP_TEMPLATE_NAME).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE_NAME=otp_login       # optional — defaults to otp_login
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US       # optional — defaults to en_US

# Razorpay (plan upgrades / AMC seat purchases)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
